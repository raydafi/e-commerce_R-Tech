{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - R-Tech{% endblock %}

{% block stylesheets %}
<style>
    /* ── CORRECTION DU FOND ── */
    body { background-color: #f4f4f4 !important; }

    .product-show-container {
        max-width: 1100px;
        margin: 4rem auto;
        padding: 0 2rem;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
    }

    /* ── IMAGE WRAPPER ── */
    .product-image-section {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        min-height: 500px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    }

    .product-image-section img {
        max-width: 90%;
        max-height: 450px;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    .product-image-section:hover img {
        transform: scale(1.05);
    }

    /* ── INFO SECTION ── */
    .product-info-section {
        display: flex;
        flex-direction: column;
    }

    .category-badge {
        align-self: flex-start;
        padding: 4px 12px;
        background: #e7f3ff;
        color: #007bff;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 1.5rem;
    }

    .product-title {
        font-family: var(--font-display);
        font-size: 3rem;
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1.1;
        margin-bottom: 1rem;
        letter-spacing: -1px;
    }

    .product-price {
        font-size: 2.2rem;
        font-weight: 800;
        color: #007bff;
        margin-bottom: 2rem;
    }

    .product-description {
        font-size: 1.1rem;
        line-height: 1.7;
        color: var(--text-secondary);
        margin-bottom: 2.5rem;
    }

    /* ── ACTIONS ── */
    .btn-add-cart {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        background: #007bff;
        color: white;
        padding: 18px 32px;
        text-decoration: none;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1.1rem;
        transition: all 0.2s ease;
        box-shadow: 0 10px 20px rgba(0,123,255,0.15);
    }

    .btn-add-cart:hover {
        background: #0056b3;
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(0,123,255,0.25);
    }

    .back-link {
        margin-top: 2rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-secondary);
        font-weight: 500;
        transition: color 0.2s;
    }

    .back-link:hover {
        color: #007bff;
    }

    @media (max-width: 850px) {
        .product-show-container {
            grid-template-columns: 1fr;
            gap: 2rem;
            margin: 2rem auto;
        }
        .product-image-section { min-height: 350px; }
        .product-title { font-size: 2.2rem; }
    }
</style>
{% endblock %}

{% block body %}
<div class="product-show-container">
    
    {# Section Image #}
    <div class="product-image-section">
        {% if product.image %}
            <img src="{{ asset('uploads/images/products/' ~ product.image) }}" alt="{{ product.name }}">
        {% else %}
            <div style="text-align: center; color: #ccc;">
                <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m3 9 5-5 4 4 3-3 6 6"/></svg>
                <p>Image non disponible</p>
            </div>
        {% endif %}
    </div>

    {# Section Détails #}
    <div class="product-info-section">
        
        <span class="category-badge">
            {{ product.category ? product.category.name : 'Général' }}
        </span>
        
        <h1 class="product-title">{{ product.name }}</h1>
        
        <div class="product-price">
            {{ product.price|number_format(2, ',', ' ') }} €
        </div>
        
        <p class="product-description">
            {{ product.description }}
        </p>

        <a href="{{ path('cart_add', {id: product.id}) }}" class="btn-add-cart">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            Ajouter au panier
        </a>
        
        <a href="{{ path('app_product_index') }}" class="back-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Retour au catalogue
        </a>
    </div>
</div>
{% endblock %}