{% extends 'base.html.twig' %}

{% block title %}Modifier mes informations - R-Tech{% endblock %}

{% block stylesheets %}
<style>
    /* ── FORÇAGE DU STYLE GLOBAL ──────────────────────────────── */
    body { background-color: #f4f4f4 !important; }

    /* ── PAGE LAYOUT ──────────────────────────────────────────── */
    .edit-page {
        max-width: 680px;
        margin: 3rem auto;
        padding: 0 2rem;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--text-secondary);
        margin-bottom: 2rem;
    }

    .breadcrumb a {
        color: var(--text-secondary);
        transition: color 0.2s;
    }

    .breadcrumb a:hover {
        color: #007bff;
    }

    .breadcrumb .current {
        color: var(--text-primary);
        font-weight: 600;
    }

    .page-heading {
        font-family: var(--font-display);
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.5px;
        color: var(--text-primary);
        margin-bottom: 0.3rem;
    }

    .page-subheading {
        font-size: 15px;
        color: var(--text-secondary);
        margin-bottom: 2rem;
    }

    /* ── FORM CARD ────────────────────────────────────────────── */
    .form-card {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.03);
    }

    .form-card-header {
        padding: 18px 24px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fcfcfc;
    }

    .form-card-header svg {
        color: #007bff;
    }

    .form-card-title {
        font-family: var(--font-display);
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .form-card-body {
        padding: 2.5rem 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    /* ── FORM FIELDS ──────────────────────────────────────────── */

    .form-card-body .form-group,
    .form-card-body > div {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-card-body label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: var(--text-secondary);
    }

    .form-card-body input {
        width: 100%;
        background: #f8f9fa;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 12px 16px;
        font-family: var(--font-body);
        font-size: 14px;
        color: var(--text-primary);
        outline: none;
        transition: all 0.2s ease;
    }

    .form-card-body input:focus {
        border-color: #007bff;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(0, 123, 255, 0.1);
    }

    /* Error messages */
    .form-card-body .form-error,
    .invalid-feedback {
        font-size: 13px;
        color: #dc3545;
        margin-top: 4px;
    }

    /* ── FORM FOOTER ──────────────────────────────────────────── */
    .form-card-footer {
        padding: 1.5rem 2rem;
        background: #fcfcfc;
        border-top: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 14px;
        font-weight: 600;
        color: var(--text-secondary);
        transition: color 0.2s;
    }

    .btn-back:hover {
        color: var(--text-primary);
    }

    .btn-save {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        background: #007bff;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s, transform 0.2s;
    }

    .btn-save:hover {
        background: #0056b3;
        transform: translateY(-1px);
    }

    /* ── INFO NOTE ────────────────────────────────────────────── */
    .info-note {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px;
        background: #e7f3ff;
        border: 1px solid rgba(0, 123, 255, 0.1);
        border-radius: 12px;
        font-size: 13px;
        color: #0056b3;
        line-height: 1.5;
        margin-top: 1.5rem;
    }

    .info-note svg {
        flex-shrink: 0;
        margin-top: 2px;
        color: #007bff;
    }

    /* ── RESPONSIVE ───────────────────────────────────────────── */
    @media (max-width: 560px) {
        .edit-page { padding: 0 1.5rem; margin: 2rem auto; }
        .form-card-footer { flex-direction: column-reverse; align-items: stretch; gap: 1.5rem; text-align: center; }
        .btn-save, .btn-back { justify-content: center; }
    }
</style>
{% endblock %}

{% block body %}
<div class="edit-page">

    {# ── BREADCRUMB ──────────────────────────────────────────── #}
    <nav class="breadcrumb">
        <a href="{{ path('app_home') }}">Boutique</a>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
        <a href="{{ path('app_account') }}">Mon compte</a>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
        <span class="current">Paramètres</span>
    </nav>

    {# ── HEADING ─────────────────────────────────────────────── #}
    <h1 class="page-heading">Mettre à jour mon profil</h1>
    <p class="page-subheading">Modifiez les informations de votre compte client R-Tech.</p>

    {# ── FORM CARD ───────────────────────────────────────────── #}
    <div class="form-card">
        <div class="form-card-header">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </svg>
            <span class="form-card-title">Identité</span>
        </div>

        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            <div class="form-card-body">
                <div>
                    {{ form_label(form.first_name, 'Votre Prénom') }}
                    {{ form_widget(form.first_name, {attr: {placeholder: 'Ex: Jean'}}) }}
                    {{ form_errors(form.first_name) }}
                </div>

                <div>
                    {{ form_label(form.last_name, 'Votre Nom') }}
                    {{ form_widget(form.last_name, {attr: {placeholder: 'Ex: Dupont'}}) }}
                    {{ form_errors(form.last_name) }}
                </div>
            </div>

            <div class="form-card-footer">
                <a href="{{ path('app_account') }}" class="btn-back">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
                    Annuler
                </a>
                <button type="submit" class="btn-save">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                    Enregistrer les modifications
                </button>
            </div>
        {{ form_end(form) }}
    </div>

    {# ── NOTE INFO ───────────────────────────────────────────── #}
    <div class="info-note">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="16" x2="12" y2="12"/>
            <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
        <span>L'adresse e-mail et le mot de passe ne peuvent pas être modifiés directement pour des raisons de sécurité. Contactez notre support si besoin.</span>
    </div>

</div>
{% endblock %}