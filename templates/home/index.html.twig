{% extends 'base.html.twig' %}

{% block title %}Accueil - R-Tech{% endblock %}

{% block stylesheets %}
<style>
    /* ── FORÇAGE DU FOND DE PAGE ──────────────────────────────── */
    /* On force le body en blanc/gris très clair pour écraser le bleu par défaut */
    body {
        background-color: #f4f4f4 !important;
    }

    /* ── HERO - THÈME CLAIR ───────────────────────────────────── */
    .hero { 
        background: #ffffff !important; /* Force le blanc pur ici */
        padding: 6rem 2rem 5rem; 
        text-align: center; 
        color: var(--text-primary); 
        border-bottom: 1px solid var(--border);
        margin-top: -1px; /* Évite un micro-espace avec la navbar */
    }
    
    .hero-label { 
        display: inline-block; 
        padding: 4px 14px; 
        border: 1px solid var(--border); 
        border-radius: 20px; 
        font-size: 11px; 
        font-weight: 500; 
        letter-spacing: 1.2px; 
        text-transform: uppercase; 
        margin-bottom: 1.25rem;
        color: var(--text-secondary);
    }
    
    .hero h1 { 
        font-family: var(--font-display); 
        font-size: clamp(2.5rem, 6vw, 4rem); 
        font-weight: 800; 
        letter-spacing: -1.5px; 
        line-height: 1.1; 
        margin-bottom: 1rem; 
        color: #1a1a1a;
    }
    
    .hero p { 
        font-size: 16px; 
        color: var(--text-secondary); 
        max-width: 500px; 
        margin: 0 auto 2rem; 
        line-height: 1.6; 
    }
    
    .hero-actions { 
        display: flex; 
        gap: 12px; 
        justify-content: center; 
        flex-wrap: wrap; 
    }
    
    .btn-primary { 
        padding: 12px 28px; 
        background: #1a1a1a; /* Bouton noir moderne */
        color: white; 
        border-radius: 8px; 
        font-weight: 600; 
        font-size: 15px; 
        box-shadow: 0 4px 15px rgba(0,0,0,0.1); 
        transition: transform 0.2s, background 0.2s; 
    }
    
    .btn-primary:hover { 
        transform: translateY(-2px); 
        background: #000000; 
    }

    /* ── GRILLE DES DERNIERS PRODUITS ─────────────────────────── */
    .home-section { 
        max-width: 1280px; 
        margin: 4rem auto; 
        padding: 0 2rem;
        background-color: transparent !important; /* On s'assure qu'aucun fond n'est appliqué ici */
    }
    
    .section-title { 
        font-family: var(--font-display); 
        font-size: 24px; 
        font-weight: 700; 
        color: var(--text-primary); 
        margin-bottom: 2rem; 
        text-align: center; 
    }
    
    .product-grid { 
        display: grid; 
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); 
        gap: 1.5rem; 
    }
    
    .product-card { 
        background: #ffffff !important; /* Force la carte en blanc pur */
        border: 1px solid var(--border); 
        border-radius: var(--radius-lg); 
        padding: 1.25rem; 
        display: flex; 
        flex-direction: column; 
        transition: transform var(--transition), box-shadow var(--transition);
        text-decoration: none; /* Enlève le soulignement du lien */
    }
    
    .product-card:hover { 
        transform: translateY(-5px); 
        box-shadow: 0 10px 25px rgba(0,0,0,0.05); 
        border-color: #007bff;
    }
    
    .card-img-wrapper { 
        height: 180px; 
        background: #f8f9fa; /* Fond image gris très clair neutre */
        border-radius: var(--radius-sm); 
        margin-bottom: 1.25rem; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        overflow: hidden; 
    }
    
    .card-img-wrapper img { 
        width: 100%; 
        height: 100%; 
        object-fit: cover; 
    }
    
    .card-tag { 
        align-self: flex-start; 
        padding: 3px 10px; 
        background: #e7f3ff; 
        border-radius: 20px; 
        font-size: 11px; 
        font-weight: 600; 
        color: #007bff; 
        margin-bottom: 0.75rem; 
    }
    
    .card-title { 
        font-size: 16px; 
        font-weight: 600; 
        margin-bottom: 0.5rem; 
        color: #1a1a1a;
    }
    
    .card-price { 
        font-size: 20px; 
        font-weight: 700; 
        margin-top: 1rem; 
        color: #007bff; /* On garde le bleu uniquement sur le prix pour l'accentuation */
    }
</style>
{% endblock %}

{% block body %}
<section class="hero">
    <span class="hero-label">✦ Bienvenue sur R-Tech</span>
    <h1>Dans l'ère de la Tech !</h1>
    <p>Appareils, accessoires et composants électroniques pour les passionnés.</p>
    <div class="hero-actions">
        <a href="{{ path('app_product_index') }}" class="btn-primary">Explorer le catalogue</a>
    </div>
</section>

<section class="home-section">
    <h2 class="section-title">Dernières nouveautés</h2>
    <div class="product-grid">
        {% for product in products %}
            <a href="{{ path('app_product_show', {id: product.id}) }}" class="product-card">
                <div class="card-img-wrapper">
                    {% if product.image %}
                        <img src="{{ asset('uploads/images/products/' ~ product.image) }}" alt="{{ product.name }}">
                    {% else %}
                        <div style="color:#ccc; display:flex; flex-direction:column; align-items:center; font-size:12px;">
                             <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m3 9 5-5 4 4 3-3 6 6"/></svg>
                             <span>Pas d'image</span>
                        </div>
                    {% endif %}
                </div>
                <span class="card-tag">{{ product.category ? product.category.name : 'Nouveau' }}</span>
                <h3 class="card-title">{{ product.name }}</h3>
                <div class="card-price">{{ product.price|number_format(2, ',', ' ') }} €</div>
            </a>
        {% endfor %}
    </div>
</section>
{% endblock %}